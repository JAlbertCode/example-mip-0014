// SPDX-License-Identifier: Apache-2.0
//
// Reference implementation of MIP-0014, Native Unshielded Token Standard:
// https://github.com/midnightntwrk/midnight-improvement-proposals/blob/main/mips/mip-0014-native-unshielded-token.md
//
// Composable mint/burn authorization: a hash-commitment gate.
//
// Kept separate from the core token so an issuer picks its own policy without
// changing the token. Compose it and call `assertMinter()` atop guarded circuits.
//
// It stores the authorized identity as a `Bytes<32>` commitment and checks the
// caller in-circuit against a secret, so authorization is bound to the proof.
//
// This is one policy. Multisig, roles, or constructor-only issuance compose the
// same way.

pragma language_version 0.23;

module MintAuthorization {
  import CompactStandardLibrary;

  // The minter's secret. Supplied off-chain; verified in-circuit, never revealed.
  // (A private circuit input would work identically.)
  witness secretKey(): Bytes<32>;

  // Public commitment to the authorized minter: persistentHash of the secret,
  // domain-separated. Set once at construction.
  export ledger minter: Bytes<32>;

  // Call from the composing contract's constructor with the commitment the issuer
  // computed off-chain as `authPublicKey(secret)`.
  export circuit initialize(minter_: Bytes<32>): [] {
    minter = disclose(minter_);
  }

  // Canonical mint-authorization separator, defined once. Convention
  // midnight:<layer>:<purpose>, must be <= 32 bytes, and byte-identical across
  // every implementation or commitments will not match. src/commitment.ts mirrors it.
  circuit mintAuthDomain(): Bytes<32> {
    return pad(32, "midnight:unshielded:minter"); // 26 bytes
  }

  // Derive the public commitment from a secret, domain-separated by
  // mintAuthDomain() so a commitment can't be replayed against another contract.
  circuit authPublicKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([mintAuthDomain(), sk]);
  }

  // Revert unless the caller proves knowledge of the committed secret.
  export circuit assertMinter(): [] {
    assert(minter == authPublicKey(secretKey()), "only minter");
  }
}
