// SPDX-License-Identifier: Apache-2.0
//
// Reference implementation of MIP-0014, Native Unshielded Token Standard:
// https://github.com/midnightntwrk/midnight-improvement-proposals/blob/main/mips/mip-0014-native-unshielded-token.md
//
// Native unshielded token: core module.
//
// An issuer, not a custodian: the contract creates supply (`_mint`) and destroys
// it (`_burn`) and exposes metadata, but holding, transfer, receipt, and balance
// checks are native ledger operations that never touch it.
//
// `_mint` and `_burn` carry no authorization; that is a composable policy the
// importing contract adds, so an issuer picks its own policy without changing the
// token.
//
// `domain` is a parameter, not stored state, so one deployment can issue many
// colors, one per domain: `tokenType(domain, thisContractAddress)`.

pragma language_version 0.23;

module NativeUnshieldedToken {
  import CompactStandardLibrary;

  // Metadata. Identity is the color, not these labels. Underscore = private;
  // read through the getters below.
  sealed ledger _name: Opaque<"string">;
  sealed ledger _symbol: Opaque<"string">;
  sealed ledger _decimals: Uint<8>;

  // Call from the composing contract's constructor.
  export circuit initialize(
    name_: Opaque<"string">,
    symbol_: Opaque<"string">,
    decimals_: Uint<8>,
  ): [] {
    _name = disclose(name_);
    _symbol = disclose(symbol_);
    _decimals = disclose(decimals_);
  }

  // Getters are how another contract reads this token's state on-chain, so they
  // are required.
  export circuit name(): Opaque<"string"> {
    return _name;
  }

  export circuit symbol(): Opaque<"string"> {
    return _symbol;
  }

  export circuit decimals(): Uint<8> {
    return _decimals;
  }

  // Derived at call time, not stored: in a constructor `kernel.self()` is a
  // placeholder, so a stored color would be wrong.
  export circuit tokenColor(domain: Bytes<32>): Bytes<32> {
    return tokenType(disclose(domain), kernel.self());
  }

  // Mint `amount` of the `domain` color to `recipient`; returns the color. Reverts
  // on a zero recipient. No authorization: the composer gates it.
  export circuit _mint(
    domain: Bytes<32>,
    recipient: Either<ContractAddress, UserAddress>,
    amount: Uint<64>,
  ): Bytes<32> {
    assert(!isZeroRecipient(recipient), "NativeUnshieldedToken: mint to the zero address");
    // Unshielded mints are public, so the arguments are disclosed.
    return mintUnshieldedToken(disclose(domain), disclose(amount), disclose(recipient));
  }

  // Destroy `amount` of the `domain` color: the caller supplies the coins and the
  // contract forwards them to the unspendable burn address. `receiveUnshielded`
  // reverts if the inputs do not cover `amount`. Retiring coins into the contract
  // is not a burn. Burns are read from the live UTXO set, since the coins land on
  // an address no key can spend.
  export circuit _burn(domain: Bytes<32>, amount: Uint<128>): [] {
    const color = tokenType(disclose(domain), kernel.self());
    receiveUnshielded(color, disclose(amount));
    sendUnshielded(
      color,
      disclose(amount),
      right<ContractAddress, UserAddress>(unshieldedBurnAddress()),
    );
  }

  // Unspendable burn target: an all-zeroes `UserAddress` no key can sign for.
  circuit unshieldedBurnAddress(): UserAddress {
    return default<UserAddress>;
  }

  circuit isZeroRecipient(recipient: Either<ContractAddress, UserAddress>): Boolean {
    return recipient.is_left
      ? recipient.left == default<ContractAddress>
      : recipient.right == default<UserAddress>;
  }
}
