// SPDX-License-Identifier: Apache-2.0
//
// Reference implementation of MIP-0014, Native Unshielded Token Standard:
// https://github.com/midnightntwrk/midnight-improvement-proposals/blob/main/mips/mip-0014-native-unshielded-token.md
//
// Example issuer: a single-color, fixed-supply native unshielded token.
//
// The whole supply is minted once, then the contract is done. The mint runs in a
// one-shot `initialize()` after deploy, not in the constructor: during
// construction `kernel.self()` is a zero placeholder (the address is derived from
// the initial state the constructor produces), which would color the coins wrong.
// `initialize()` runs with the real address.
//
// `initialize()` needs no authorization: the recipient and amount are fixed at
// construction, so whoever calls it only performs the deployer's intent, and the
// `minted` flag makes it one-shot.

pragma language_version 0.23;

import CompactStandardLibrary;
import "./modules/NativeUnshieldedToken" prefix Token_;

// Immutable domain separator for this issuer's single color. Changing it changes
// the color and would orphan every outstanding UTXO.
export sealed ledger domain: Bytes<32>;

// Mint target and amount, fixed at construction so `initialize()` can stay ungated.
sealed ledger mintRecipient: Either<ContractAddress, UserAddress>;
sealed ledger mintAmount: Uint<64>;

// One-shot guard.
ledger minted: Boolean;

constructor(
  name_: Opaque<"string">,
  symbol_: Opaque<"string">,
  decimals_: Uint<8>,
  domain_: Bytes<32>,
  recipient: Either<ContractAddress, UserAddress>,
  amount: Uint<64>,
) {
  Token_initialize(name_, symbol_, decimals_);
  domain = disclose(domain_);
  mintRecipient = disclose(recipient);
  mintAmount = disclose(amount);
}

// Mint the whole supply to the fixed recipient. Runs once (the `minted` flag), and
// runs after deploy so `kernel.self()` is the real address.
export circuit initialize(): [] {
  assert(!minted, "FixedSupply: already minted");
  minted = true;
  Token__mint(domain, mintRecipient, mintAmount);
}

// --- Metadata & discovery (the only other circuits this token exposes) -------

export circuit name(): Opaque<"string"> {
  return Token_name();
}

export circuit symbol(): Opaque<"string"> {
  return Token_symbol();
}

export circuit decimals(): Uint<8> {
  return Token_decimals();
}

export circuit tokenColor(): Bytes<32> {
  return Token_tokenColor(domain);
}
